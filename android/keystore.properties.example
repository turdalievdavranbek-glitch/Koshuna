# Copy to android/keystore.properties (that file is gitignored) OR export the env vars below.
# Do not commit passwords or the .jks file.
#
# storeFile=/absolute/path/to/upload-keystore.jks
# storePassword=
# keyAlias=upload
# keyPassword=
#
# Env names read by android/app/build.gradle:
#   KOSHUNA_KEYSTORE_PATH
#   KOSHUNA_KEYSTORE_PASSWORD
#   KOSHUNA_KEY_ALIAS
#   KOSHUNA_KEY_PASSWORD
storeFile=
storePassword=
keyAlias=upload
keyPassword=
