# Native sign-in (Шаг 1 hooks, buttons are Шаг 8). Leave empty until the consoles exist.
# Google: Web client id (….apps.googleusercontent.com). Android client is package + SHA-1.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Apple: Services ID, and the redirect URL registered for it.
NEXT_PUBLIC_APPLE_SERVICE_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URL=https://koshuna.ru/auth/apple/callback

# Optional shop / media settings (not required for the manual shop flow)

# Cloud video/speech adapter for trading points. If unset, the app parses
# on-device speech locally and never pretends a cloud analysis succeeded.
SHOP_AI_URL=
SHOP_AI_KEY=

# Upload caps used by shop video (client + /api/shops/validate).
# Listing video is checked by the server (POST /api/uploads and ffprobe on complete).
VIDEO_MAX_BYTES=83886080
VIDEO_MAX_SECONDS=120
NEXT_PUBLIC_VIDEO_MAX_BYTES=83886080
NEXT_PUBLIC_VIDEO_MAX_SECONDS=120

# --- Server (Шаг 4). Real values live in /etc/koshuna/backend.env on the VPS. ---
DATABASE_URL=postgres://koshuna_app:CHANGE_ME@127.0.0.1:5432/koshuna
MEDIA_DIR=/var/koshuna/media
MEDIA_URL_PREFIX=/media
SESSION_SECRET=            # openssl rand -hex 32
JOBS_SECRET=               # openssl rand -hex 32
AUTH_DEMO_ENABLED=true     # set false when real login ships (Шаг 8)
SERVE_MEDIA=0              # 1 only in local dev; nginx serves /media in production
FFPROBE_PATH=ffprobe
PHOTO_MAX_BYTES=10485760
VOICE_MAX_BYTES=10485760
VOICE_MAX_SECONDS=120
NEXT_PUBLIC_VOICE_MAX_SECONDS=120
LISTING_TTL_DAYS=30
LISTING_GRACE_DAYS=7
LISTING_AUTO_EXPIRE=false  # true only after Шаг 16/18 can deliver «Ещё актуально?»
# ALLOW_DEMO_SEED=1        # dev machines only, never on the server
